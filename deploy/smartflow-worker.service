[Unit]
Description=SmartFlow assignment worker
After=network.target

[Service]
User=smartflow
WorkingDirectory=/opt/smartflow/backend
EnvironmentFile=/opt/smartflow/.env
ExecStart=/opt/smartflow/backend/.venv/bin/python -m app.worker
Restart=on-failure
Environment=SMARTFLOW_LOCAL=0
StandardOutput=append:/var/log/smartflow-worker.log
StandardError=append:/var/log/smartflow-worker.log

[Install]
WantedBy=multi-user.target
